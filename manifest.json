{
  "manifest_version": 3,
  "name": "Job Application Copilot",
  "version": "0.1.0",
  "description": "Review and fill job applications from an encrypted local profile.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_popup": "src/popup.html", "default_title": "Application Copilot" },
  "options_page": "src/options.html",
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["src/content.js"],
    "css": ["src/content.css"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
